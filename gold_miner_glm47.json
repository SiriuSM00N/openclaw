      "title": "代码生成 - 黄金矿工钩子状态机（TypeScript）",
      "code": `interface HookState {
  onEnter(): void;
  onExit(): void;
  update(deltaTime: number): void;
  canTransitionTo(state: HookStateType): boolean;
}

enum HookStateType {
  IDLE = "idle",
  SWINGING = "swinging",
  LAUNCHING = "launching",
  RETRACTING = "retracting",
  GRABBING = "grabbing"
}

class HookMachine {
  private currentState: HookState;
  private states: Map<HookStateType, HookState>;
  public position: { x: number; y: number };
  public angle: number;
  public speed: number;
  public maxLength: number;
  public grabbedItem: any | null;
  public isGrabbingHeavy: boolean = false;

  constructor() {
    this.position = { x: 0, y: 0 };
    this.angle = 0;
    this.speed = 0;
    this.maxLength = 500;
    this.grabbedItem = null;
    
    this.states = new Map();
    this.states.set(HookStateType.IDLE, new IdleState(this));
    this.states.set(HookStateType.SWINGING, new SwingingState(this));
    this.states.set(HookStateType.LAUNCHING, new LaunchingState(this));
    this.states.set(HookStateType.RETRACTING, new RetractingState(this));
    this.states.set(HookStateType.GRABBING, new GrabbingState(this));
    
    this.currentState = this.states.get(HookStateType.IDLE)!;
    this.currentState.onEnter();
  }

  transitionTo(stateType: HookStateType): boolean {
    if (this.currentState.canTransitionTo(stateType)) {
      this.currentState.onExit();
      this.currentState = this.states.get(stateType)!;
      this.currentState.onEnter();
      return true;
    }
    return false;
  }

  update(deltaTime: number): void {
    this.currentState.update(deltaTime);
  }

  launch(): void {
    this.transitionTo(HookStateType.LAUNCHING);
  }
}

// 状态实现类

class IdleState implements HookState {
  constructor(private machine: HookMachine) {}

  onEnter(): void {
    console.log("进入待命状态");
    this.machine.speed = 0;
    this.machine.grabbedItem = null;
  }

  onExit(): void {
    console.log("退出待命状态");
  }

  update(deltaTime: number): void {
    // 自动过渡到摆动状态
    this.machine.transitionTo(HookStateType.SWINGING);
  }

  canTransitionTo(state: HookStateType): boolean {
    return state === HookStateType.SWINGING;
  }
}

class SwingingState implements HookState {
  private swingDirection: number = 1;
  private swingSpeed: number = 2;
  private minAngle: number = -60;
  private maxAngle: number = 60;

  constructor(private machine: HookMachine) {}

  onEnter(): void {
    console.log("进入摆动状态");
    this.machine.angle = 0;
  }

  onExit(): void {
    console.log("退出摆动状态");
  }

  update(deltaTime: number): void {
    this.machine.angle += this.swingDirection * this.swingSpeed;
    
    // 边界处理：角度超出范围时反转方向
    if (this.machine.angle >= this.maxAngle) {
      this.machine.angle = this.maxAngle;
      this.swingDirection = -1;
    } else if (this.machine.angle <= this.minAngle) {
      this.machine.angle = this.minAngle;
      this.swingDirection = 1;
    }
  }

  canTransitionTo(state: HookStateType): boolean {
    return state === HookStateType.LAUNCHING;
  }
}

class LaunchingState implements HookState {
  private launchSpeed: number = 300;
  private distanceTraveled: number = 0;

  constructor(private machine: HookMachine) {}

  onEnter(): void {
    console.log("进入发射状态");
    this.machine.speed = this.launchSpeed;
    this.distanceTraveled = 0;
  }

  onExit(): void {
    console.log("退出发射状态");
  }

  update(deltaTime: number): void {
    const distance = this.machine.speed * deltaTime;
    this.distanceTraveled += distance;
    
    const radians = (this.machine.angle * Math.PI) / 180;
    this.machine.position.x += Math.cos(radians) * distance;
    this.machine.position.y += Math.sin(radians) * distance;
    
    // 边界情况 1：达到最大长度
    if (this.distanceTraveled >= this.machine.maxLength) {
      this.machine.transitionTo(HookStateType.RETRACTING);
      return;
    }
    
    // 边界情况 2：检测碰撞（这里需要实现碰撞检测）
    if (this.checkCollision()) {
      this.machine.transitionTo(HookStateType.GRABBING);
      return;
    }
  }

  private checkCollision(): boolean {
    // 简化实现：实际游戏需要碰撞检测系统
    return false;
  }

  canTransitionTo(state: HookStateType): boolean {
    return state === HookStateType.RETRACTING || state === HookStateType.GRABBING;
  }
}

class RetractingState implements HookState {
  private baseRetractSpeed: number = 150;

  constructor(private machine: HookMachine) {}

  onEnter(): void {
    console.log("进入回收状态");
    this.calculateRetractSpeed();
  }

  onExit(): void {
    console.log("退出回收状态");
  }

  update(deltaTime: number): void {
    const radians = (this.machine.angle * Math.PI) / 180;
    
    // 计算回退距离
    const distance = this.machine.speed * deltaTime;
    this.machine.position.x -= Math.cos(radians) * distance;
    this.machine.position.y -= Math.sin(radians) * distance;
    
    // 边界情况：回到原点
    if (this.machine.position.x <= 0 && this.machine.position.y <= 0) {
      this.machine.position = { x: 0, y: 0 };
      this.machine.transitionTo(HookStateType.IDLE);
      
      // 交付物品逻辑
      if (this.machine.grabbedItem) {
        this.deliverItem(this.machine.grabbedItem);
        this.machine.grabbedItem = null;
      }
    }
  }

  private calculateRetractSpeed(): void {
    if (this.machine.grabbedItem) {
      const weight = this.machine.grabbedItem.weight || 1;
      this.machine.speed = this.baseRetractSpeed / weight;
    } else {
      this.machine.speed = this.baseRetractSpeed;
    }
  }

  private deliverItem(item: any): void {
    // 实现物品交付逻辑
    console.log(\`交付物品: \${item.name}, 价值: \${item.value}\`);
  }

  canTransitionTo(state: HookStateType): boolean {
    return state === HookStateType.IDLE;
  }
}

class GrabbingState implements HookState {
  private grabDuration: number = 0.5;
  private elapsedTime: number = 0;

  constructor(private machine: HookMachine) {}

  onEnter(): void {
    console.log("进入抓取状态");
    this.elapsedTime = 0;
    this.performGrab();
  }

  onExit(): void {
    console.log("退出抓取状态");
  }

  update(deltaTime: number): void {
    this.elapsedTime += deltaTime;
    
    if (this.elapsedTime >= this.grabDuration) {
      this.machine.transitionTo(HookStateType.RETRACTING);
    }
  }

  private performGrab(): void {
    // 简化实现：实际游戏需要抓取逻辑
    this.machine.grabbedItem = {
      name: "金块",
      value: 100,
      weight: 2
    };
  }

  canTransitionTo(state: HookStateType): boolean {
    return state === HookStateType.RETRACTING;
  }
}

// 使用示例
const hookMachine = new HookMachine();
hookMachine.launch();`
